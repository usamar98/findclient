{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --include=dev",
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/continue-scan",
      "schedule": "* * * * *"
    }
  ]
}
