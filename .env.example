# Canonical origin. Leave empty until choosing the production domain.
NEXT_PUBLIC_SITE_URL=

# Supabase project settings. Only the URL and publishable key belong in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configure a matching model and its current per-million-token USD rates when changing models.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
AI_MAX_USD_PER_CREDIT=0.005

# Web search for indexed Reddit, Indie Hackers, X and public forum posts.
EXA_API_KEY=
# Optional higher Stack Exchange quota.
STACK_EXCHANGE_KEY=

# Stripe-hosted Checkout uses these two server settings. Set both after deployment
# and redeploy. Copy the endpoint's signing secret for /api/stripe/webhook.
# Use test keys for preview and live keys for production. See README for event types.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Use a verified Resend sender address.
RESEND_API_KEY=
EMAIL_FROM=

# Telegram BotFather settings. Username excludes the leading @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# A long random token for Vercel Cron and authenticated indexing requests.
CRON_SECRET=

# Public brand details. Add only verified URLs.
FOUNDER_NAME=
FOUNDER_URL=
BRAND_X_URL=
BRAND_GITHUB_URL=
BRAND_PRODUCT_HUNT_URL=
BRAND_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_HANDLE=
SUPPORT_EMAIL=

# Paste the verification content values, without meta tag markup.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=

# Optional public tracker URL and website identifier from the provider's snippet.
TRUSTMRR_SCRIPT_URL=
TRUSTMRR_WEBSITE_ID=
